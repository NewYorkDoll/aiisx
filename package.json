{
  "name": "aiisx-vite",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "api": "tsx server/index.ts",
    "api:dev": "tsx watch server/index.ts",
    "auth:switch": "tsx server/auth-switch.ts",
    "auth:xbox": "tsx server/auth-xbox.ts",
    "migrate:mysql": "tsx server/migrate-mysql.ts",
    "sync:games": "tsx server/sync-games.ts",
    "sync:platforms": "tsx server/sync-platforms.ts",
    "sync:platforms:schedule": "tsx server/sync-platforms.ts --schedule",
    "dev:all": "concurrently \"npm run api:dev\" \"npm run dev\"",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "@libsql/client": "^0.17.4",
    "@react-three/fiber": "^9.7.0",
    "@tanstack/react-router": "^1.170.32",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "hono": "^4.13.5",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "undici": "^7.29.0",
    "xal-node": "^1.1.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "mysql2": "^3.24.2",
    "oxlint": "^1.79.0",
    "tsx": "^4.23.12",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
